# Copy to .env in the repository root. This file is loaded only by FastAPI.
OPENAI_API_KEY=
LLM_PROVIDER=openai
STT_PROVIDER=openai
TTS_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
STT_MODEL=gpt-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
MOCK_MODE=false
REQUEST_TIMEOUT=35
# SESSION_ARCHIVE_DIR defaults to <repository>/runtime/sessions.
# Set an absolute path here only to override that location.
